# Skopiuj ten plik do .env.local (lokalnie) i uzupełnij te same zmienne w
# ustawieniach projektu Vercel (Production + Preview). Szczegółowa instrukcja
# krok po kroku znajduje się w ADMIN_SETUP.md.

# --- Supabase (wymagane, aby CMS i panel /admin działały) --------------------
# Project Settings → API w panelu Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tylko do uruchamiania supabase/seed.mjs lokalnie / z CI. NIGDY nie ustawiaj
# tej zmiennej w środowisku przeglądarki ani nie commituj jej do repozytorium.
SUPABASE_SERVICE_ROLE_KEY=

# --- Formularz kontaktowy (opcjonalne, ale zalecane) --------------------------
# Klucz API z https://resend.com — bez niego formularz nadal zapisuje
# zgłoszenia w tabeli contact_submissions, ale nie wyśle powiadomienia e-mail.
RESEND_API_KEY=
# Adres, na który mają przychodzić powiadomienia z formularza.
CONTACT_EMAIL_TO=biuro@edmat.pl
# Adres nadawcy widoczny w wysyłanych e-mailach (musi być zweryfikowaną domeną
# w Resend na produkcji; domyślnie używany jest testowy adres onboarding@resend.dev).
CONTACT_EMAIL_FROM="EDMAT — formularz kontaktowy <onboarding@resend.dev>"

# --- Środowisko ----------------------------------------------------------------
# Ustaw na "production" WYŁĄCZNIE na docelowej domenie produkcyjnej. Sterowanie
# indeksowaniem (robots.txt) i innymi zachowaniami zależnymi od środowiska.
# Na Vercel Preview Deployments pozostaw puste lub "preview", aby uniknąć
# przypadkowego zaindeksowania środowiska podglądu przez wyszukiwarki.
NEXT_PUBLIC_SITE_ENV=development
